# otp: nur E-Mail und Einmalcode. password: nur E-Mail und Passwort.
AUTH_MODE=otp

ADMIN_EMAIL=admin@example.com
# Nur bei AUTH_MODE=password, mindestens 8 Zeichen.
ADMIN_PASSWORD=

# Mindestens 16 Zeichen. Zum Beispiel: openssl rand -hex 24
SESSION_SECRET=replace-with-a-long-random-string

# Port auf dem Host. Im Container bleibt 8080.
PORT=8080

# Die merkbare Adresse dieser Instanz, ohne Slash am Ende.
PUBLIC_URL=http://localhost:8080

# Pflicht bei AUTH_MODE=otp, unbenutzt bei password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=speicherling@example.com

MAX_UPLOAD_MB=200
